{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "clsx": "^2.1.1",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^1.25.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.25.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "check": "npm run verify:release-source && npm run test:store-config && npm run test:client && npm run test:runtime && npm run test:motion && npm run test:dependencies && npm run test:content && npm run typecheck && npm run export:web && npm run export:android && npm run export:ios",
    "verify:release-source": "node ./scripts/verify-release-source.mjs",
    "verify:store-config": "node ./scripts/verify-store-config.mjs",
    "verify:production-config": "EAS_BUILD_PROFILE=production node ./scripts/verify-store-config.mjs",
    "release:preflight": "npm run verify:release-source && npm run verify:production-config && npx expo config --type public",
    "eas-build-pre-install": "node ./scripts/verify-store-config.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "preexport:web": "node ./scripts/verify-web-config.mjs",
    "export:web": "expo export -p web",
    "typecheck": "node --stack_size=16384 ./node_modules/typescript/bin/tsc --noEmit",
    "test:client": "node ./scripts/test-api-client.mjs",
    "test:store-config": "node --test ./scripts/test-store-config.mjs ./scripts/test-android-launcher.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "release:preflight:android": "npm run verify:release-source && npm run verify:production-config -- --platform android && npx expo config --type public",
    "release:preflight:ios": "npm run verify:release-source && npm run verify:production-config -- --platform ios && npx expo config --type public",
    "test:runtime": "node --test ./scripts/test-runtime-recovery.mjs ./scripts/test-account-notifications.mjs ./scripts/test-data-refresh.mjs ./scripts/test-dealer-workflows.mjs ./scripts/test-messaging-safety.mjs ./scripts/test-manager-leads.mjs ./scripts/test-onboarding.mjs ./scripts/test-availability.mjs ./scripts/test-onboarding-journey.mjs ./scripts/test-dev-training-toggle.mjs ./scripts/test-development-features.mjs",
    "test:dependencies": "node --test ./scripts/test-security-overrides.mjs",
    "test:content": "node --test ./scripts/test-in-app-content.mjs ./scripts/test-pdf-document.mjs ./scripts/test-financing.mjs",
    "test:motion": "node --test ./scripts/test-motion.mjs ./scripts/test-design-system.mjs",
    "eas:update:preview": "npm run verify:release-source && npx eas-cli@latest env:exec preview 'node ./scripts/verify-update-environment.mjs preview' && npx eas-cli@latest update --channel preview --environment preview --clear-cache",
    "eas:update:production": "npm run verify:release-source && npx eas-cli@latest env:exec production 'node ./scripts/verify-update-environment.mjs production' && npx eas-cli@latest update --channel production --environment production --clear-cache"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component",
    "uuid": "11.1.1"
  }
}
