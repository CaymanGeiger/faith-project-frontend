{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "clsx": "^2.1.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "lucide-react-native": "^1.25.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "check": "npm run verify:release-source && npm run typecheck && npm run export:web",
    "verify:release-source": "node ./scripts/verify-release-source.mjs",
    "verify:store-config": "node ./scripts/verify-store-config.mjs",
    "verify:production-config": "EAS_BUILD_PROFILE=production node ./scripts/verify-store-config.mjs",
    "release:preflight": "npm run verify:release-source && npm run verify:production-config && npx expo config --type public",
    "eas-build-pre-install": "node ./scripts/verify-store-config.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
    "preexport:web": "node ./scripts/verify-web-config.mjs",
    "export:web": "expo export -p web",
    "typecheck": "node --stack_size=16384 ./node_modules/typescript/bin/tsc --noEmit",
    "test:client": "node ./scripts/test-api-client.mjs"
  },
  "private": true
}
