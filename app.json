{
  "expo": {
    "name": "Hercules Honors Rewards",
    "slug": "hercules-honors-rewards",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/hercules-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/hercules-logo-optimized.png",
          "imageWidth": 252,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/brand/hercules-logo-optimized.png"
          }
        }
      ]
    ],
    "scheme": "herculeshonors",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d41a427b-e738-4eda-9da3-03722c2bbc45"
      }
    },
    "owner": "caymangeigers-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d41a427b-e738-4eda-9da3-03722c2bbc45"
    }
  }
}
