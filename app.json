{
  "expo": {
    "name": "Hercules Honors Rewards",
    "slug": "hercules-honors-rewards",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/hercules-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/hercules-app-icon.png",
        "monochromeImage": "./assets/brand/logo-header-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.herculesindustries.honorsrewards"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/hercules-logo-optimized.png",
          "imageWidth": 252,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withAndroidLauncherInsets.cjs",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages"
        }
      ]
    ],
    "scheme": "herculeshonors",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d41a427b-e738-4eda-9da3-03722c2bbc45"
      }
    },
    "owner": "caymangeigers-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d41a427b-e738-4eda-9da3-03722c2bbc45"
    }
  }
}
