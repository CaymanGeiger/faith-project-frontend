# Local development only. Configure HTTPS equivalents as the EAS `production`
# environment variables before building a store submission.
# Before any EAS native build, add the company-owned ios.bundleIdentifier and
# android.package directly to app.json. The build guard intentionally rejects
# Expo's default com.placeholder.appid value.
# Configure the same non-local HTTPS API and WSS/HTTPS socket values in the
# Vercel project before publishing the legal pages and signed-out deletion form.
EXPO_PUBLIC_API_URL=http://localhost:3002
EXPO_PUBLIC_WS_URL=http://localhost:3002/messaging

# Explicit deployment environment: development, preview, or production.
# Expo preview updates also use release-mode JavaScript, so NODE_ENV and __DEV__
# do not identify whether the app is intended for testing.
EXPO_PUBLIC_APP_ENV=development

# Master switch for demo login, demo invitation prefill and training tools.
# Enable deliberately in development/preview. Production, missing or unknown
# APP_ENV values disable all tools even if this flag is accidentally true.
EXPO_PUBLIC_DEV_FEATURES_ENABLED=false

# Temporary dealer-menu training toggle. Requires the master switch above,
# a development/preview APP_ENV, and the backend's independent testing gates.
# Store production uses APP_ENV=production and both public flags=false.
EXPO_PUBLIC_DEV_TRAINING_TOGGLE=false
